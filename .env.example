# Local development only. Copy to .env, which Git ignores, and fill in the values;
# ./gradlew :backend:bootRun reads it. Never commit a real value.

# Comma-separated addresses that are operators from their first sign-in.
BEYONDPILOT_IDENTITY_OPERATOR_EMAILS=

# Google OAuth client for sign-in; leave empty to run without Google.
BEYONDPILOT_IDENTITY_GOOGLE_CLIENT_ID=
BEYONDPILOT_IDENTITY_GOOGLE_CLIENT_SECRET=
