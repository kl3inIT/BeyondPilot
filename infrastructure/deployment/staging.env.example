# /apps/beyondpilot/.env.staging on the staging host: root-owned, mode 0600. It feeds Compose interpolation
# of compose.staging.yaml and holds no secret; secrets are files under /apps/beyondpilot/secrets.

# Comma-separated addresses that are operators from their first sign-in.
BEYONDPILOT_IDENTITY_OPERATOR_EMAILS=

# The Google OAuth client of staging; its secret is /apps/beyondpilot/secrets/google-client-secret.
# Authorized redirect URIs: https://beyondpilot.vadan.app/login/oauth2/code/google and
# https://beyondpilot.ai/login/oauth2/code/google
BEYONDPILOT_IDENTITY_GOOGLE_CLIENT_ID=
