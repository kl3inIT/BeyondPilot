# /apps/beyondpilot/.env.production on the host: root-owned, mode 0600. It feeds Compose interpolation
# of compose.production.yaml and holds no secret; secrets are files under /apps/beyondpilot/secrets.

# Sender of every email; Mailpit keeps them all until production has an email provider.
BEYONDPILOT_MAIL_FROM=BeyondPilot <no-reply@beyondpilot.ai>

# Comma-separated addresses that are operators from their first sign-in.
BEYONDPILOT_IDENTITY_OPERATOR_EMAILS=

# The Google OAuth client; its secret is /apps/beyondpilot/secrets/google-client-secret.
# Authorized redirect URIs: https://beyondpilot.vadan.app/login/oauth2/code/google and
# https://beyondpilot.ai/login/oauth2/code/google
BEYONDPILOT_IDENTITY_GOOGLE_CLIENT_ID=
